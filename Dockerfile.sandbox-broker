# syntax=docker/dockerfile:1.7
FROM rust:1.95-bookworm@sha256:6258907abe69656e41cd992e0b705cdcfabcbbe3db374f92ed2d47121282d4a1 AS builder
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake git libssl-dev perl pkg-config protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY . .
RUN cargo build --locked --release -p buzz-sandbox-broker && strip target/release/buzz-sandbox-broker

FROM debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder --chmod=0755 /build/target/release/buzz-sandbox-broker /usr/local/bin/buzz-sandbox-broker
# Runs as root ONLY to reach the docker socket group; it mounts no host paths
# other than that socket and creates containers exclusively through the API.
ENTRYPOINT ["/usr/local/bin/buzz-sandbox-broker"]
